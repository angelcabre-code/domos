[Unit]
Description=Domos Kiosk go2rtc Low-Latency Stream Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=domos
WorkingDirectory=/opt/domoskiosk
ExecStart=/usr/local/bin/go2rtc -config /opt/domoskiosk/go2rtc.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
